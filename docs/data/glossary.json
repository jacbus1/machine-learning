  "entries": [
    {
      "id": "machine-learning",
      "term": "Machine Learning",
      "aliases": [
        "ML",
        "機器學習"
      ],
      "category": "foundations",
      "definition": "讓電腦從資料中的例子學出可重複使用的規律，再對新的輸入做預測或決策。",
      "why": "它把資料、模型、目標函數與評估流程接成一個可以檢查的系統。",
      "module": "Module 1",
      "unitId": "machine-learning-introduction",
      "related": [
        "supervised-learning",
        "model",
        "generalization"
      ]
    },
    {
      "id": "supervised-learning",
      "term": "Supervised Learning",
      "aliases": [
        "監督式學習"
      ],
      "category": "foundations",
      "definition": "使用帶有已知答案（label）的樣本學習輸入與目標之間的關係。",
      "why": "有了 label，模型才可以比較預測與答案的差距，進而學習。",
      "module": "Module 1",
      "unitId": "supervised-learning-introduction",
      "related": [
        "feature",
        "label",
        "regression",
        "classification"
      ]
    },
    {
      "id": "feature",
      "term": "Feature",
      "aliases": [
        "predictor",
        "input",
        "特徵",
        "輸入變數"
      ],
      "category": "foundations",
      "definition": "模型在預測時可使用的輸入欄位或變數，例如房屋面積、讀書時間或出席率。",
      "why": "feature 必須在預測當下可取得，否則會造成不公平或資料洩漏。",
      "module": "Module 1",
      "unitId": "supervised-learning-introduction",
      "related": [
        "label",
        "target",
        "data-leakage",
        "design-matrix"
      ]
    },
    {
      "id": "label",
      "term": "Label",
      "aliases": [
        "target value",
        "答案",
        "標籤"
      ],
      "category": "foundations",
      "definition": "訓練樣本中已知、且模型要學習預測的答案。分類的 label 是類別；回歸的 label 通常是連續數值。",
      "why": "label 的定義與品質直接決定模型學習的方向。",
      "module": "Module 1",
      "unitId": "supervised-learning-introduction",
      "related": [
        "target",
        "regression",
        "classification"
      ]
    },
    {
      "id": "target",
      "term": "Target",
      "aliases": [
        "response",
        "outcome",
        "目標變數"
      ],
      "category": "foundations",
      "definition": "建模問題中希望預測或解釋的輸出變數，常以 y 表示。",
      "why": "先確定 target，才能判斷是 regression、classification，並選對 metric。",
      "module": "Module 1",
      "related": [
        "label",
        "regression",
        "classification",
        "prediction"
      ]
    },
    {
      "id": "model",
      "term": "Model",
      "aliases": [
        "模型"
      ],
      "category": "foundations",
      "definition": "把輸入資料轉成預測的規則或函數；它可以是線性方程、樹、神經網路或其他模型家族。",
      "why": "模型不是只有一個分數，而是一組可訓練、可評估、可部署的假設。",
      "module": "Module 1",
      "related": [
        "parameter",
        "hyperparameter",
        "generalization"
      ]
    },
    {
      "id": "parameter",
      "term": "Parameter",
      "aliases": [
        "參數",
        "coefficient"
      ],
      "category": "foundations",
      "definition": "模型在訓練過程中由資料估計出來的數值，例如線性模型的 intercept 與 slope。",
      "why": "parameter 決定模型對輸入如何產生輸出；它與由使用者設定的 hyperparameter 不同。",
      "module": "Module 2",
      "related": [
        "hyperparameter",
        "slope",
        "intercept",
        "least-squares"
      ]
    },
    {
      "id": "hyperparameter",
      "term": "Hyperparameter",
      "aliases": [
        "超參數"
      ],
      "category": "foundations",
      "definition": "在訓練前或訓練外由使用者設定、而非直接由模型 fit 出來的控制值，例如 learning rate、正則化強度或樹深度。",
      "why": "hyperparameter 應用 validation 或 cross-validation 選擇，不能偷看 test set。",
      "module": "Module 2",
      "related": [
        "parameter",
        "cross-validation",
        "train-validation-test"
      ]
    },
    {
      "id": "prediction",
      "term": "Prediction",
      "aliases": [
        "預測",
        "ŷ"
      ],
      "category": "foundations",
      "definition": "把新的 feature 輸入 fitted model，產生對 target 的估計值，通常以 ŷ 表示。",
      "why": "Prediction 關心新樣本會得到什麼輸出；它不同於解讀變數關係的 inference。",
      "module": "Module 1–2",
      "related": [
        "inference",
        "fitted-value",
        "generalization"
      ]
    },
    {
      "id": "inference",
      "term": "Inference",
      "aliases": [
        "推論",
        "coefficient interpretation"
      ],
      "category": "foundations",
      "definition": "利用模型係數與不確定性理解變數和 target 的方向、大小與實際意義。",
      "why": "同一個模型可以用來預測，也可以用來回答「X 和 Y 的關係如何」；兩個目的不能混為一談。",
      "module": "Module 2",
      "related": [
        "slope",
        "intercept",
        "prediction",
        "causation"
      ]
    },
    {
      "id": "regression",
      "term": "Regression",
      "aliases": [
        "回歸"
      ],
      "category": "regression",
      "definition": "target 是可在數值尺度上連續變化的 supervised learning 任務，例如預測房價、分數或溫度。",
      "why": "任務類型由 target 決定；選擇 regression 後才會使用合適的 loss 與 error metric。",
      "module": "Module 1–2",
      "related": [
        "classification",
        "simple-linear-regression",
        "multiple-linear-regression"
      ]
    },
    {
      "id": "classification",
      "term": "Classification",
      "aliases": [
        "分類"
      ],
      "category": "foundations",
      "definition": "target 是有限的類別或標籤，例如通過／不通過、垃圾郵件／非垃圾郵件。",
      "why": "classification 的輸出與評估方式和連續數值 prediction 不同。",
      "module": "Module 1",
      "related": [
        "regression",
        "label",
        "metric"
      ]
    },
    {
      "id": "simple-linear-regression",
      "term": "Simple Linear Regression",
      "aliases": [
        "SLR",
        "簡單線性回歸"
      ],
      "category": "regression",
      "definition": "只使用一個 predictor X，以直線描述或預測一個連續 target Y 的模型。",
      "why": "它是理解係數、殘差、least squares、prediction 與 inference 的最小完整模型。",
      "formula": "Y = β₀ + β₁X + ε",
      "module": "Module 2",
      "unitId": "simple-linear-regression",
      "related": [
        "linear-regression",
        "multiple-linear-regression",
        "slope",
        "residual"
      ]
    },
    {
      "id": "linear-regression",
      "term": "Linear Regression",
      "aliases": [
        "線性回歸"
      ],
      "category": "regression",
      "definition": "假設 target 的系統性部分可以由輸入變數的線性組合表示的 regression 模型。",
      "why": "linear 不代表資料點完美排成直線，而是模型用線性組合表達平均關係。",
      "formula": "ŷ = β₀ + β₁x",
      "module": "Module 2",
      "related": [
        "simple-linear-regression",
        "multiple-linear-regression",
        "linear-model"
      ]
    },
    {
      "id": "multiple-linear-regression",
      "term": "Multiple Linear Regression",
      "aliases": [
        "MLR",
        "多元線性回歸"
      ],
      "category": "regression",
      "definition": "使用多個 predictors 共同預測一個連續 target 的線性模型。",
      "why": "當單一 feature 無法解釋足夠變異時，可以加入更多有意義的 predictors，但要注意共線性、leakage 與解讀邊界。",
      "formula": "ŷ = β₀ + β₁x₁ + ··· + βₚxₚ",
      "module": "Module 2",
      "related": [
        "simple-linear-regression",
        "feature",
        "design-matrix",
        "interaction"
      ]
    },
    {
      "id": "linear-model",
      "term": "Linear Model",
      "aliases": [
        "線性模型"
      ],
      "category": "regression",
      "definition": "以參數的線性組合表示預測值的模型；輸入可以是原始 feature，也可以是轉換後的 feature。",
      "why": "它讓係數有清楚的代數與 domain 解讀，並可用矩陣運算有效處理大量樣本。",
      "module": "Module 1–2",
      "related": [
        "linear-regression",
        "design-matrix",
        "parameter"
      ]
    },
    {
      "id": "intercept",
      "term": "Intercept",
      "aliases": [
        "β₀",
        "截距"
      ],
      "category": "regression",
      "definition": "當 X=0 時模型直線的基準輸出，控制直線在垂直方向的位置。",
      "why": "它是模型必須估計的參數；但 X=0 若不在實際資料範圍內，不能直接當成有現實意義的情境。",
      "formula": "β₀",
      "module": "Module 2",
      "related": [
        "slope",
        "simple-linear-regression"
      ]
    },
    {
      "id": "slope",
      "term": "Slope",
      "aliases": [
        "β₁",
        "斜率",
        "coefficient"
      ],
      "category": "regression",
      "definition": "X 每增加一個單位時，模型預測的 Y 平均改變量；正負表示方向。",
      "why": "解讀 slope 時必須同時說明單位、條件與「association 不自動等於 causation」。",
      "formula": "β₁ = ΔY / ΔX",
      "module": "Module 2",
      "related": [
        "intercept",
        "inference",
        "simple-linear-regression"
      ]
    },
    {
      "id": "error-term",
      "term": "Error Term",
      "aliases": [
        "ε",
        "誤差項"
      ],
      "category": "regression",
      "definition": "真實結果中由模型沒有納入、無法量測或隨機變動造成的部分；它屬於概念上的真實資料生成關係。",
      "why": "分清 error term ε 與可由樣本計算的 residual e，是理解線性回歸的關鍵。",
      "formula": "Y = β₀ + β₁X + ε",
      "module": "Module 2",
      "related": [
        "residual",
        "fitted-value"
      ]
    },
    {
      "id": "residual",
      "term": "Residual",
      "aliases": [
        "e",
        "殘差"
      ],
      "category": "regression",
      "definition": "觀察到的 target 與 fitted model 預測值之差；本課採用 e = Y − ŷ。",
      "why": "residual 顯示每個樣本被模型低估或高估多少，也是診斷模型假設與計算 error metrics 的基礎。",
      "formula": "eᵢ = yᵢ − ŷᵢ",
      "module": "Module 2",
      "unitId": "simple-linear-regression",
      "related": [
        "error-term",
        "least-squares",
        "mse",
        "heteroscedasticity"
      ]
    },
    {
      "id": "fitted-value",
      "term": "Fitted Value",
      "aliases": [
        "ŷ",
        "預測擬合值"
      ],
      "category": "regression",
      "definition": "把一筆已知或新的 X 代入已估計的模型後得到的預測輸出。",
      "why": "它與實際觀察值 y 一起定義 residual；對新資料 prediction 時不會加上事先未知的 ε。",
      "formula": "ŷ = β̂₀ + β̂₁x",
      "module": "Module 2",
      "related": [
        "prediction",
        "residual",
        "parameter"
      ]
    },
    {
      "id": "least-squares",
      "term": "Least Squares",
      "aliases": [
        "最小平方法",
        "平方誤差最小"
      ],
      "category": "regression",
      "definition": "選擇模型參數，使所有觀察值與 fitted value 之間的 residual 平方和最小的估計原則。",
      "why": "它把「最佳直線」轉成可以計算、比較與驗證的明確目標。",
      "formula": "SSE = Σᵢ(yᵢ − ŷᵢ)²",
      "module": "Module 2",
      "related": [
        "ordinary-least-squares",
        "residual",
        "mse"
      ]
    },
    {
      "id": "ordinary-least-squares",
      "term": "Ordinary Least Squares (OLS)",
      "aliases": [
        "OLS",
        "普通最小平方法"
      ],
      "category": "regression",
      "definition": "最常見的 least-squares 線性回歸估計法，直接以 residual 的平方和作為 fit 的目標。",
      "why": "它連接課程中的 fitted line、係數估計、residual 與後續的 MSE/R²。",
      "formula": "β̂₁ = Σ(xᵢ−x̄)(yᵢ−ȳ) / Σ(xᵢ−x̄)²",
      "module": "Module 2",
      "related": [
        "least-squares",
        "slope",
        "mse"
      ]
    },
    {
      "id": "design-matrix",
      "term": "Design Matrix",
      "aliases": [
        "X matrix",
        "設計矩陣"
      ],
      "category": "math",
      "definition": "把每個 sample 的 predictors 以 rows、把每個 feature 以 columns 排列成的矩陣，線性模型可用它批次計算預測。",
      "why": "它是從資料表走到 ŷ = Xβ 的橋樑，並讓 dimension 檢查成為明確規則。",
      "formula": "ŷ = Xβ",
      "module": "Module 1–2",
      "related": [
        "matrix",
        "vector",
        "linear-model",
        "multiple-linear-regression"
      ]
    },
    {
      "id": "scalar",
      "term": "Scalar",
      "aliases": [
        "純量"
      ],
      "category": "math",
      "definition": "單一數值，例如 5、−3 或 0.1；它不是向量或矩陣。",
      "why": "scalar、vector、matrix 的分層是讀懂 ML notation 與矩陣運算的起點。",
      "module": "Module 1",
      "related": [
        "vector",
        "matrix"
      ]
    },
    {
      "id": "vector",
      "term": "Vector",
      "aliases": [
        "向量"
      ],
      "category": "math",
      "definition": "按照順序排列的一組 scalar；在資料科學中常代表一個 sample 的 features 或一組 model weights。",
      "why": "向量讓一筆觀察與一組參數可以用一致的數學表示。",
      "module": "Module 1",
      "related": [
        "scalar",
        "matrix",
        "dot-product",
        "design-matrix"
      ]
    },
    {
      "id": "matrix",
      "term": "Matrix",
      "aliases": [
        "矩陣"
      ],
      "category": "math",
      "definition": "由 rows 與 columns 組成的數值表；在 ML 中通常 rows 是 observations，columns 是 features。",
      "why": "資料集、係數與批次預測都常以矩陣表示，維度錯誤會直接使運算失敗。",
      "module": "Module 1",
      "related": [
        "vector",
        "transpose",
        "design-matrix",
        "dot-product"
      ]
    },
    {
      "id": "transpose",
      "term": "Transpose",
      "aliases": [
        "轉置",
        "ᵀ"
      ],
      "category": "math",
